<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OpenAIDictation.Core\OpenAIDictation.Core.csproj" />
    <EmbeddedResource Include="Assets\handy-marimba-start.wav" LogicalName="OpenAIDictation.HandyStart.wav" />
    <None Update="Assets\Handy-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>OpenAIDictation</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF owns startup/DPI; WinForms is used only for the notification-area icon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

</Project>
